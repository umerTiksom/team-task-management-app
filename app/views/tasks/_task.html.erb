<% @task.each do |t| %>

  <div class="task-card">

    <div class="task-card-header">

      <h2>
        <%= t.tittle %>
      </h2>

      <span class="task-status">
        <%= t.status %>
      </span>

    </div>


    <div class="task-card-body">

      <div class="task-info">

        <span class="task-label">
          Description
        </span>

        <p>
          <%= t.description %>
        </p>

      </div>


      <div class="task-info">

        <span class="task-label">
          Priority
        </span>

        <p>
          <%= t.priority %>
        </p>

      </div>


      <div class="task-info">

        <span class="task-label">
          Status
        </span>

        <p>
          <%= t.status %>
        </p>

      </div>

    </div>


    <div class="task-card-actions">

      <%= link_to "Update",
                  edit_task_path(t),
                  class: "update-btn" %>


      <%= button_to "Delete",
                    task_path(t),
                    method: :delete,
                    class: "delete-btn",
                    data: {
                      turbo_confirm: "Are you sure you want to delete this task?"
                    } %>

    </div>

  </div>

<% end %>
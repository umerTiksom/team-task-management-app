<div class="task-details-page">
  <h1>Task Details</h1>
  <%= form_with url: task_details_path, method: :get, local: true, class: "task-search-form" do |form| %>
    <%= form.text_field :query,
                        placeholder: "Enter the task title",
                        class: "task-search-input" %>
    <%= form.submit "Search", class: "task-search-btn" %>
  <% end %>
  <% if params[:query].present? %>
    <% if @task %>
      <div class="task-card">
        <div class="task-card-header">
          <h2><%= @task.tittle %></h2>
          <span class="task-status">
            <%= @task.status %>
          </span>
        </div>
        <div class="task-card-body">
          <div class="task-info">
            <span class="task-label">Description</span>
            <p><%= @task.description %></p>
          </div>
          <div class="task-info">
            <span class="task-label">Priority</span>
            <p><%= @task.priority %></p>
          </div>
          <div class="task-info">
            <span class="task-label">Status</span>
            <p><%= @task.status %></p>
          </div>
          <p>
            <strong>Owner:</strong>
            <%= @task.user.name %>
          </p>
        </div>
        <div class="task-card-actions">
          <%= link_to "Update Task",
                      edit_task_path(@task),
                      class: "update-btn" %>
          <%= button_to "Delete Task",
                        task_path(@task),
                        method: :delete,
                        class: "delete-btn",
                        data: {
                          turbo_confirm: "Are you sure you want to delete this task?"
                        } %>
        </div>
      </div>
    <% else %>
      <div class="task-not-found">
        <h2>Task Not Found</h2>
        <p>No task found with the title "<%= params[:query] %>".</p>
      </div>
    <% end %>
  <% end %>
</div>
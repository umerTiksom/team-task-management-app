<%= form_with model: @task, class: "task-form" do |form| %>
  <% if @task.errors.any? %>
    <div class="error-occur">
      <h2><%= pluralize(@task.errors.count, "errors") %>Unable to save this task: </h2>
      <ul>
        <% @task.errors.full_messages.each do |msg| %>
        <l1><%= msg %></l1>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :tittle, "Tittle" %>
    <%= form.text_field :tittle %>
  </div>
  <div>
    <%= form.label :description, "Description" %>
    <%= form.text_area :description %>
  </div>
  <div>
    <%= form.label :status, "Status" %>
    <%= form.select :status, ["in-progress", "pending", "completed"] %>
  </div>
  <div>
    <%= form.label :priority, "Priority" %>
    <%= form.select :priority, ["high", "medium", "low"] %>
  </div>
  <div>
    <%= form.label :user_id, "Task Owner" %>
    <%= form.collection_select :user_id,
        User.all,
        :id,
        :name,
        prompt: "Select Task Owner" %>
  </div>
  <%= form.submit "Create Task" %>
<% end %>